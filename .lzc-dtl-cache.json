{
  "name": "Beaver Habit Tracker",
  "package": "cloud.lazycat.app.beaverhabits",
  "description": "一个无需“目标”的自托管习惯追踪应用程序",
  "homepage": "https://github.com/daya0576/beaverhabits",
  "author": "daya0576",
  "app_features": [
    "background_task",
    "public_path"
  ],
  "subdomain": "beaverhabits",
  "version": "0.0.1",
  "public_paths": [
    "/"
  ],
  "iconPath": "icon.png",
  "composePath": "docker-compose.yml",
  "unsupported_platforms": [],
  "lastRouteType": "from_compose",
  "port_mappings": {
    "beaverhabits_8080_8080": {
      "use": true,
      "type": "http",
      "path": "/",
      "targetPath": "/"
    }
  },
  "image_daya0576_beaverhabits_latest": {
    "originalImage": "daya0576/beaverhabits:latest",
    "pushTarget": "none"
  },
  "beaverhabits_volume_/app/.user/_action": "emptyDir",
  "beaverhabits_volume_/app/.user/_location": "app_data"
}
